{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.zugadotechnologies.com"
        }
      ],
      "destination": "https://zugadotechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/studio/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/studio/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
